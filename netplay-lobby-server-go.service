[Unit]
Description=RetroArch lobby server
After=network.target

[Service]
WorkingDirectory=/root/netplay-lobby-server-go
ExecStart=/root/netplay-lobby-server-go/netplay-lobby-server-go -v
KillMode=process
Restart=always
RestartSec=5
Type=simple
User=root
Group=root

[Install]
WantedBy=multi-user.target
